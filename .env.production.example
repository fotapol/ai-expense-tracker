# Production env template. Copy to `.env.production`, fill secrets, then run:
# python infra/k8s/scripts/render_k8s_env.py --env-file .env.production

# Core
APP_ENV=production
PUBLIC_API_BASE_URL=https://api.nexavend.store:8443
PUBLIC_APP_BASE_URL=https://nexavend.store
APP_ADMIN_EMAILS=
API_DOCS_ENABLED=false
TRUSTED_HOSTS=api.nexavend.store,expense-tracker-api,expense-tracker-api.expense-tracker,expense-tracker-api.expense-tracker.svc,expense-tracker-api.expense-tracker.svc.cluster.local
CORS_ALLOWED_ORIGINS=https://nexavend.store
RUN_STARTUP_MIGRATIONS=false
MAX_RECEIPT_FILE_BYTES=15728640
LOG_LEVEL=INFO
LOG_JSON=true
PROXY_DIAGNOSTICS_ENABLED=false
UVICORN_FORWARDED_ALLOW_IPS=*
INGRESS_CLASS_NAME=nginx
INGRESS_TLS_SECRET_NAME=expense-tracker-origin-tls

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/
RABBITMQ_USER=expense_tracker
RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-password
RABBITMQ_ERLANG_COOKIE=replace-with-long-random-erlang-cookie
RABBITMQ_URL=
RECEIPT_EXTRACTION_QUEUE_NAME=receipt_extraction

# Storage
MINIO_ROOT_USER=expense-storage
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
S3_ENDPOINT=http://minio:9000
S3_EXTERNAL_ENDPOINT=https://storage.nexavend.store:8443
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-central-1
S3_BUCKET_RECEIPTS=receipts
S3_BUCKET_BACKUPS=postgres-backups
S3_PRESIGNED_PUT_EXPIRY_SECONDS=600
S3_PRESIGNED_GET_EXPIRY_SECONDS=600

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase_sa.json
FIREBASE_SERVICE_ACCOUNT_JSON_B64=replace-with-base64-encoded-firebase-service-account-json

# AI
LLM_PROVIDER=google
GOOGLE_API_KEY=replace-with-google-ai-key
LLM_MODEL_NAME=gemini-2.5-flash
RECEIPT_PROCESSING_STALE_AFTER_MINUTES=15
RECEIPT_PROCESSING_MAX_RETRIES=3
RECEIPT_PROCESSING_RETRY_BACKOFF_SECONDS=5

# FX
FRANKFURTER_BASE_URL=https://api.frankfurter.app
CURRENCY_API_CDN_BASE_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api
FX_HTTP_TIMEOUT_SECONDS=8

# Metrics and images
METRICS_ENABLED=true
METRICS_API_PATH=/metrics
WORKER_METRICS_PORT=9101
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-with-langsmith-key
LANGSMITH_PROJECT=ai-expense-tracker-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
BACKEND_IMAGE=ghcr.io/fotapol/ai-expense-tracker-backend:prod-1
SITE_IMAGE=ghcr.io/fotapol/ai-expense-tracker-site:prod-1
POSTGRES_BACKUP_IMAGE=ghcr.io/fotapol/ai-expense-tracker-postgres-backup:prod-1

# Billing
REVENUECAT_SECRET_API_KEY=replace-with-revenuecat-secret-api-key
REVENUECAT_API_BASE_URL=https://api.revenuecat.com
REVENUECAT_HTTP_TIMEOUT_SECONDS=8
REVENUECAT_PERSONAL_PREMIUM_ENTITLEMENT_ID=personal_premium
REVENUECAT_FAMILY_PREMIUM_ENTITLEMENT_ID=family_premium
REVENUECAT_PERSONAL_PRODUCT_IDS=personal_premium,individual_plan_monthly,individual_plan_yearly
REVENUECAT_FAMILY_PRODUCT_IDS=family_premium,family_plan_monthly,family_plan_yearly
REVENUECAT_WEBHOOK_AUTH_HEADER=Authorization
REVENUECAT_WEBHOOK_AUTH_SECRET=replace-with-revenuecat-webhook-secret
ENABLE_DEV_BILLING_ENDPOINTS=false
DEV_BILLING_INTERNAL_SECRET=
DEV_BILLING_ADMIN_EMAILS=

# Monitoring and backups
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=2GB
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
GRAFANA_ROOT_URL=http://127.0.0.1:3000
POSTGRES_BACKUP_SCHEDULE=0 3 * * *
POSTGRES_BACKUP_RETENTION_DAYS=30
POSTGRES_BACKUP_PREFIX=postgres

# App metadata
APP_WEBSITE_URL=https://nexavend.store
APP_PRIVACY_URL=https://nexavend.store/privacy
APP_TERMS_URL=https://nexavend.store/terms
APP_DELETE_ACCOUNT_URL=https://nexavend.store/delete-account
APP_PLAY_SUBSCRIPTIONS_URL=https://play.google.com/store/account/subscriptions?package=com.nexavend.expense_tracker_app
APP_GITHUB_URL=
APP_SUPPORT_EMAIL=support@nexavend.store
APP_SUPPORT_SUBJECT=AI Expense Tracker Support
SITE_APP_STORE_URL=
SITE_GOOGLE_PLAY_URL=
SITE_OPEN_APP_URL=
API_BASE_URL=https://api.nexavend.store:8443
REVENUECAT_ANDROID_API_KEY=replace-with-android-public-sdk-key
REVENUECAT_IOS_API_KEY=replace-with-ios-public-sdk-key
REVENUECAT_PREMIUM_ENTITLEMENT_ID=personal_premium
