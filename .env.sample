# ==============================================================================
# BASE APPLICATION SETTINGS
# ==============================================================================

# APP_ENV must be set to 'production' for live deployments. Unlocks stricter validations.
APP_ENV=development

# The public URL where your frontend is hosted. Important for CORS and links.
PUBLIC_APP_BASE_URL=https://your-public-app-domain.example

# Comma-separated list of admin emails. 
# Grants access to premium features for testing, plus debug endpoints.
APP_ADMIN_EMAILS=admin@example.com

# Server-side upload ceiling for receipt images. (Default: 15728640 = 15 MB)
MAX_RECEIPT_FILE_BYTES=15728640

# ==============================================================================
# INFRASTRUCTURE DATABASES (PostgreSQL, Redis, RabbitMQ)
# ==============================================================================
# REQUIRED IN PRODUCTION: Use strong, auto-generated passwords.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=strong_password_here
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:strong_password_here@localhost:5432/postgres

REDIS_URL=redis://redis:6379/0

# REQUIRED IN PRODUCTION: Do not use guest:guest for public accessibility.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ==============================================================================
# OBJECT STORAGE (MinIO / S3)
# ==============================================================================

# REQUIRED IN PRODUCTION: Use real S3 access keys, do not leave empty.
MINIO_ROOT_USER=admin_user
MINIO_ROOT_PASSWORD=strong_object_password

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=admin_user
S3_SECRET_KEY=strong_object_password
S3_REGION=eu-central-1
S3_BUCKET_RECEIPTS=receipts

# REQUIRED IN PRODUCTION: Must be a publicly reachable domain (e.g. https://s3.yourdomain.com)
S3_EXTERNAL_ENDPOINT=http://YOUR_PUBLIC_IP:9000

# ==============================================================================
# EXTERNAL APIS (Google, Firebase, Currency, RevenueCat)
# ==============================================================================

# Path to the downloaded Firebase Admin SDK Service Account JSON
# Required for any authentication to succeed.
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase_sa.json

# REQUIRED IN PRODUCTION: Gemini Vision API key for receipt extraction
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL_NAME=gemini-2.5-flash

FRANKFURTER_BASE_URL=https://api.frankfurter.app
CURRENCY_API_CDN_BASE_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api
FX_HTTP_TIMEOUT_SECONDS=8

# ==============================================================================
# SUBSCRIPTION & BILLING (RevenueCat)
# ==============================================================================

# REQUIRED IN PRODUCTION: Secret key from RevenueCat dashboard for server-side sync
REVENUECAT_SECRET_API_KEY=your_revenuecat_secret_key

# Public keys - typically only needed by clients, but documented here
REVENUECAT_ANDROID_API_KEY=your_revenuecat_android_public_key
REVENUECAT_IOS_API_KEY=your_revenuecat_ios_public_key

REVENUECAT_API_BASE_URL=https://api.revenuecat.com
REVENUECAT_HTTP_TIMEOUT_SECONDS=8

# Entitlement and Product IDs configured in RevenueCat
REVENUECAT_PERSONAL_PREMIUM_ENTITLEMENT_ID=personal_premium
REVENUECAT_PERSONAL_PRODUCT_IDS=individual_plan_monthly,individual_plan_yearly

# ==============================================================================
# DEV ENDPOINTS
# ==============================================================================

# Enable this to test billing state manipulation without real payments.
ENABLE_DEV_BILLING_ENDPOINTS=false
DEV_BILLING_INTERNAL_SECRET=dev_secret_key
DEV_BILLING_ADMIN_EMAILS=
