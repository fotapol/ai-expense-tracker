# Send only the files used by the backend, site, and backup Dockerfiles.
**
!backend/pyproject.toml
!backend/uv.lock
!backend/alembic.ini
!backend/app/**
!site/build_site.py
!site/src/**
!site/docker/40-render-site-config.sh
!site/nginx/default.conf.template
!expense_tracker_app/web/favicon.png
!expense_tracker_app/assets/brand/logo-login-*.png
!infra/images/postgres-backup/backup.sh

# Exclude runtime configuration and caches inside included source directories.
**/.env*
**/.secrets/
**/__pycache__/
**/*.py[cod]
