# ==============================================================================
# LOCAL / DEVELOPMENT ENVIRONMENT TEMPLATE
# Copy to `.env` for Docker Compose or local backend work.
# ==============================================================================

APP_ENV=development
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_APP_BASE_URL=http://localhost:3000
APP_ADMIN_EMAILS=admin@example.com
API_DOCS_ENABLED=true
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RUN_STARTUP_MIGRATIONS=true
MAX_RECEIPT_FILE_BYTES=15728640
LOG_LEVEL=INFO
LOG_JSON=false
PROXY_DIAGNOSTICS_ENABLED=false
UVICORN_FORWARDED_ALLOW_IPS=*
INGRESS_CLASS_NAME=nginx
INGRESS_TLS_SECRET_NAME=expense-tracker-origin-tls

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=expense_pass
DATABASE_URL=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/
RABBITMQ_USER=expense_worker
RABBITMQ_PASSWORD=expense_worker_pass
RABBITMQ_ERLANG_COOKIE=change-me-local-cookie
RABBITMQ_URL=
RECEIPT_EXTRACTION_QUEUE_NAME=receipt_extraction

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://minio:9000
S3_EXTERNAL_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-central-1
S3_BUCKET_RECEIPTS=receipts
S3_BUCKET_BACKUPS=postgres-backups
S3_PRESIGNED_PUT_EXPIRY_SECONDS=600
S3_PRESIGNED_GET_EXPIRY_SECONDS=600

FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase_sa.json
FIREBASE_SERVICE_ACCOUNT_JSON_B64=

LLM_PROVIDER=google
GOOGLE_API_KEY=
LLM_MODEL_NAME=gemini-2.5-flash
RECEIPT_PROCESSING_STALE_AFTER_MINUTES=15
RECEIPT_PROCESSING_MAX_RETRIES=3
RECEIPT_PROCESSING_RETRY_BACKOFF_SECONDS=5

FRANKFURTER_BASE_URL=https://api.frankfurter.app
CURRENCY_API_CDN_BASE_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api
FX_HTTP_TIMEOUT_SECONDS=8

METRICS_ENABLED=true
METRICS_API_PATH=/metrics
WORKER_METRICS_PORT=9101
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-expense-tracker-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
BACKEND_IMAGE=ghcr.io/example/ai-expense-tracker-backend:latest
SITE_IMAGE=ghcr.io/example/ai-expense-tracker-site:latest
POSTGRES_BACKUP_IMAGE=ghcr.io/example/ai-expense-tracker-postgres-backup:latest

REVENUECAT_SECRET_API_KEY=
REVENUECAT_API_BASE_URL=https://api.revenuecat.com
REVENUECAT_HTTP_TIMEOUT_SECONDS=8
REVENUECAT_PERSONAL_PREMIUM_ENTITLEMENT_ID=personal_premium
REVENUECAT_FAMILY_PREMIUM_ENTITLEMENT_ID=family_premium
REVENUECAT_PERSONAL_PRODUCT_IDS=personal_premium,individual_plan_monthly,individual_plan_yearly
REVENUECAT_FAMILY_PRODUCT_IDS=family_premium,family_plan_monthly,family_plan_yearly
REVENUECAT_WEBHOOK_AUTH_HEADER=Authorization
REVENUECAT_WEBHOOK_AUTH_SECRET=

ENABLE_DEV_BILLING_ENDPOINTS=false
DEV_BILLING_INTERNAL_SECRET=
DEV_BILLING_ADMIN_EMAILS=

PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=2GB
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-change-me
GRAFANA_ROOT_URL=http://grafana.local
POSTGRES_BACKUP_SCHEDULE=0 3 * * *
POSTGRES_BACKUP_RETENTION_DAYS=14
POSTGRES_BACKUP_PREFIX=postgres

APP_WEBSITE_URL=http://localhost:3000
APP_PRIVACY_URL=http://localhost:3000/privacy
APP_TERMS_URL=http://localhost:3000/terms
APP_DELETE_ACCOUNT_URL=http://localhost:3000/delete-account
APP_PLAY_SUBSCRIPTIONS_URL=https://play.google.com/store/account/subscriptions?package=com.nexavend.expense_tracker_app
APP_GITHUB_URL=https://github.com/expense-tracker/ai-expense-tracker
APP_SUPPORT_EMAIL=support@example.com
APP_SUPPORT_SUBJECT=Expense Tracker Support
SITE_APP_STORE_URL=
SITE_GOOGLE_PLAY_URL=
SITE_OPEN_APP_URL=

API_BASE_URL=http://10.0.2.2:8000
REVENUECAT_ANDROID_API_KEY=
REVENUECAT_IOS_API_KEY=
REVENUECAT_PREMIUM_ENTITLEMENT_ID=personal_premium
